<UserControl x:Class="MvvmScarletToolkit.Avalonia.Samples.Views.PasswordView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MvvmScarletToolkit.Avalonia.Samples.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:features="clr-namespace:MvvmScarletToolkit.Core.Samples.Features;assembly=MvvmScarletToolkit.Core.Samples"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="features:PasswordViewModel"
             mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0 8 0 4" />
        </Style>
    </UserControl.Styles>

    <!--  Avalonia needs no behavior for this, a TextBox with a PasswordChar can be bound like any other  -->
    <StackPanel Margin="4">
        <TextBlock Classes="header" Text="Password" />
        <TextBox Classes="clearButton"
                 PasswordChar="*"
                 Text="{Binding Password}" />

        <TextBlock Classes="header" Text="Clear text (Casing)" />
        <TextBlock Text="{Binding Password, Converter={converters:ToCase}, ConverterParameter=Normal}" />
        <TextBlock Text="{Binding Password, Converter={converters:ToCase}, ConverterParameter=Upper}" />
        <TextBlock Text="{Binding Password, Converter={converters:ToCase}, ConverterParameter=Lower}" />
        <TextBlock Text="{Binding Password, Converter={converters:ToCase}}" />

        <TextBlock Classes="header" Text="Textbox with Watermark" />
        <TextBox PlaceholderText="Search" Text="{Binding Password, Mode=OneWay}" />
    </StackPanel>
</UserControl>
