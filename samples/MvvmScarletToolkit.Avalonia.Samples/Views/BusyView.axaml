<UserControl x:Class="MvvmScarletToolkit.Avalonia.Samples.Views.BusyView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:features="clr-namespace:MvvmScarletToolkit.Core.Samples.Features.Busy;assembly=MvvmScarletToolkit.Core.Samples"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="features:BusyViewModel"
             mc:Ignorable="d">

    <UserControl.Styles>
        <!--  a collapsed container would hide the children that get added to it  -->
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <!--  without a background only the text and the outline would open the context menu of the node  -->
        <Style Selector="Border.state">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Green" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="4 2" />
        </Style>
        <Style Selector="Border.state.busy">
            <Setter Property="BorderBrush" Value="Red" />
        </Style>
    </UserControl.Styles>

    <!--  the background makes the empty area hit testable, for its context menu and to clear the selection  -->
    <TreeView x:Name="Tree"
              Background="Transparent"
              ItemsSource="{Binding Items}"
              PointerPressed="Tree_PointerPressed"
              SelectedItem="{Binding SelectedItem}">
        <TreeView.ContextMenu>
            <ContextMenu Opening="TreeMenu_Opening">
                <MenuItem Command="{Binding AddChildCommand}" Header="Add Child" />
                <MenuItem Command="{Binding AddContainerCommand}" Header="Add Container" />
            </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.DataTemplates>
            <TreeDataTemplate DataType="features:BusyViewModel" ItemsSource="{Binding Items}">
                <Border Classes="state" Classes.busy="{Binding IsBusy}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding AddChildCommand}" Header="Add Child" />
                            <MenuItem Command="{Binding AddContainerCommand}" Header="Add Container" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="Container" />
                </Border>
            </TreeDataTemplate>

            <DataTemplate DataType="features:ObservableBusyViewModel">
                <Border Classes="state" Classes.busy="{Binding IsBusy}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding BeBusyCommand}" Header="Be Busy" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="Child" />
                </Border>
            </DataTemplate>
        </TreeView.DataTemplates>
    </TreeView>
</UserControl>
