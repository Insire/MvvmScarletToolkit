<!--  KeyValuePair<int, Guid> can't be named in xaml, so the item template uses reflection bindings  -->
<UserControl x:Class="MvvmScarletToolkit.Avalonia.Samples.Views.ObservableDictionaryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:features="clr-namespace:MvvmScarletToolkit.Core.Samples.Features;assembly=MvvmScarletToolkit.Core.Samples"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="False"
             x:DataType="features:ObservableDictionaryViewModel"
             mc:Ignorable="d">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button Command="{Binding AddCommand}" Content="Add" />
            <Button Command="{Binding RemoveCommand}" Content="Remove" />
            <Button Command="{Binding ClearCommand}" Content="Clear" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Key, StringFormat='Key: {0}'}" />
                        <TextBlock Text="{Binding Value, StringFormat='Value: {0}'}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
