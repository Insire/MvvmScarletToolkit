<UserControl x:Class="MvvmScarletToolkit.Avalonia.Samples.Views.GeometryRenderView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:geometry="clr-namespace:MvvmScarletToolkit.Avalonia.Samples.Features.Geometry"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="geometry:GeometryRenderViewModel"
             mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Path">
            <Setter Property="Fill" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Border.tile:pointerover Path">
            <Setter Property="Fill" Value="Purple" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <UniformGrid Columns="2">
            <Button Margin="2 0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding LoadCommand}"
                    Content="Load" />

            <Button Margin="2 0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding UnloadCommand}"
                    Content="Unload" />
        </UniformGrid>

        <!--  a ListBox for the virtualization, not for selecting rows  -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Single">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Height" Value="50" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="geometry:GeometryRow">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="media:Geometry">
                                <Border Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        Classes="tile">
                                    <Path Data="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
