<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Native AOT, which also enables the trim and AOT analyzers on build -->
        <PublishAot>true</PublishAot>
        <!-- the AOT optimized publish of the .NET 11 SDK only compiles, which leaves out the Avalonia resources and therefore the compiled xaml -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Include="..\..\assets\branding\png\wordmark-dark.png" Link="Assets\wordmark-dark.png" />
    </ItemGroup>

    <ItemGroup>
        <!-- README.md converted to html, shared with the WPF sample -->
        <EmbeddedResource Include="..\MvvmScarletToolkit.Wpf.Samples\Resources\readme.html" Link="Resources\readme.html" LogicalName="MvvmScarletToolkit.Avalonia.Samples.Resources.readme.html" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="HotAvalonia" PrivateAssets="All" Publish="True" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\MvvmScarletToolkit.Avalonia\MvvmScarletToolkit.Avalonia.csproj" />
      <ProjectReference Include="..\MvvmScarletToolkit.Core.Samples\MvvmScarletToolkit.Core.Samples.csproj" />
    </ItemGroup>
</Project>
