<UserControl x:Class="MvvmScarletToolkit.Wpf.Samples.Controls.TagCloud"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mvvm="http://SoftThorn.MvvmScarletToolkit.com/winfx/xaml/shared"
             xmlns:tagCloud="clr-namespace:MvvmScarletToolkit.Core.Samples.Features.TagCloud;assembly=MvvmScarletToolkit.Core.Samples"
             d:DataContext="{d:DesignInstance Type=tagCloud:TagCloudViewModel,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <DockPanel>
        <DockPanel Margin="0 0 0 4" DockPanel.Dock="Top">
            <ToggleButton x:Name="Columns"
                          Margin="8 0 0 0"
                          Padding="8 0"
                          Content="Wrap into columns"
                          DockPanel.Dock="Right" />

            <!--  the clear button comes with the theme  -->
            <TextBox VerticalContentAlignment="Center" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                <i:Interaction.Behaviors>
                    <mvvm:WatermarkBehavior Watermark="Filter tags" />
                </i:Interaction.Behaviors>
            </TextBox>
        </DockPanel>

        <!--  shows how few containers are needed, no matter how many tags there are  -->
        <TextBlock x:Name="Statistics"
                   Margin="0 4 0 0"
                   DockPanel.Dock="Bottom" />

        <TextBlock Margin="0 4 0 0"
                   DockPanel.Dock="Bottom"
                   Text="{Binding Selection}" />

        <ListBox x:Name="Tags"
                 ItemsSource="{Binding Tags}"
                 LayoutUpdated="Tags_LayoutUpdated"
                 SelectedItem="{Binding SelectedTag}"
                 VirtualizingPanel.IsVirtualizing="True">
            <ListBox.Style>
                <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type ListBox}">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <mvvm:VirtualizingWrapPanel />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                    <Style.Triggers>
                        <!--  items have to wrap in the direction that doesn't scroll  -->
                        <DataTrigger Binding="{Binding IsChecked, ElementName=Columns}" Value="True">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <mvvm:VirtualizingWrapPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type tagCloud:TagViewModel}">
                    <TextBlock FontSize="{Binding FontSize}" Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
