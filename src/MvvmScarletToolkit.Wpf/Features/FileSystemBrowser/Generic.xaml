<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:browser="clr-namespace:MvvmScarletToolkit.Wpf.Features.FileSystemBrowser"
                    xmlns:directories="clr-namespace:MvvmScarletToolkit.Wpf.Features.FileSystemBrowser.Directories"
                    xmlns:drives="clr-namespace:MvvmScarletToolkit.Wpf.Features.FileSystemBrowser.Drives"
                    xmlns:files="clr-namespace:MvvmScarletToolkit.Wpf.Features.FileSystemBrowser.Files"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:mvvm="clr-namespace:MvvmScarletToolkit"
                    xmlns:wpf="clr-namespace:MvvmScarletToolkit.Wpf">

    <browser:RelativeLocationConverter x:Key="RelativeLocationConverter" />

