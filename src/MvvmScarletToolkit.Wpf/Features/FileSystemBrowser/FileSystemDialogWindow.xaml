<Window x:Class="MvvmScarletToolkit.Wpf.Features.FileSystemBrowser.FileSystemDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:MvvmScarletToolkit.Wpf.Features.FileSystemBrowser"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="{Binding Title}"
        Width="1000"
        Height="640"
        MinWidth="640"
        MinHeight="400"
        d:DataContext="{d:DesignInstance Type=browser:FileSystemPickerViewModel}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <DockPanel Margin="8">
        <DockPanel Margin="0 8 0 0" DockPanel.Dock="Bottom">
            <Button MinWidth="80"
                    Margin="8 0 0 0"
                    Content="Cancel"
                    DockPanel.Dock="Right"
                    IsCancel="True" />

            <Button MinWidth="80"
                    AutomationProperties.AutomationId="Confirm"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmText}"
                    DockPanel.Dock="Right"
                    IsDefault="True" />

            <ComboBox MinWidth="160"
                      Margin="8 0"
                      AutomationProperties.AutomationId="Filter"
                      AutomationProperties.Name="File type"
                      DisplayMemberPath="Name"
                      DockPanel.Dock="Right"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter}">
                <ComboBox.Style>
                    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Filters.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Filters.Count}" Value="1">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <TextBlock VerticalAlignment="Center"
                       AutomationProperties.AutomationId="SelectedPath"
                       Text="{Binding SelectedPath}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SelectedPath}" />
        </DockPanel>

        <!--  the template of the view binds to its DataContext  -->
        <browser:FileSystemView DataContext="{Binding FileSystem}" ViewModel="{Binding}" />
    </DockPanel>
</Window>
